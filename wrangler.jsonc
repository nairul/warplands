{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warplands",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  /* keep variables set in the Cloudflare dashboard (e.g. GITHUB_LOGS_TOKEN) when deploying from GitHub */
  "keep_vars": true
}
